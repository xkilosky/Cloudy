{
  "id": "/",
  "name": "Cloudy — Free Storage by X-Kilo",
  "short_name": "Cloudy",
  "description": "Free Storage. One System. Your Rules. Obtain free cloud storage from multiple providers, sync folders and files offline, and expose scoped REST API keys for local offline AI models.",
